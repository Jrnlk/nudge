# Copy to .env.local and fill in. Never commit .env.local (it is gitignored).

# Supabase -> Connect -> Framework -> Next.js (or Project Settings -> API Keys).
# Both are public by design; access is controlled by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
# The anon key or the newer publishable key (sb_publishable_...). NOT the service role / secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Later (not used yet):
# Ask Nudge. Server only, never prefix with NEXT_PUBLIC_.
# ANTHROPIC_API_KEY=
# Protects app/api/cron/* (Vercel Cron sends this as a Bearer token)
# CRON_SECRET=
