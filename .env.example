# Copy to .env.local and fill in. Never commit .env.local.

# Database (Supabase or Neon Postgres)
DATABASE_URL=

# Auth (Supabase Auth or Auth.js, depending on what you choose)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ask Nudge. Server only, never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Protects app/api/cron/* (Vercel Cron sends this as a Bearer token)
CRON_SECRET=
